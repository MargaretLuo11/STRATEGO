//it downloads the link by setting its status, changing the player info to match
//it also clear the tile the link is currently on

void Game::player_downloading(Player* player, Link* link){
    int owner = link->get_owner();
    int index = players[owner - 1]->find_index(link);

    player->download_link(link, index);
    int row = link->get_row();
    int col = link->get_col();

    board[row][col]->clear();

    link->change_status();
    notifyGraphics(row,col);


}

