string Game::winner() {
    string winner;
    if(players[0]->get_data_downloaded() >= 4){
        winner = "player 1"; 
    } 
    else if(players[0]->get_virus_downloaded() >= 4){
        winner = "player 2";
    } 
    else if(players[1]->get_data_downloaded() >= 4){
        winner = "player 2";
    } 
    else if(players[1]->get_virus_downloaded() >= 4){
        winner = "player 1";
    } 
    else{
        winner = "ongoing";
    }

    return winner;
}

void Game::play_game(istream &in, bool file) {
    string command;
    string dir;
    string name;
    string line;
    istringstream input;
    bool used_ability = false;

    if(display1) {
        notifyGraphics();
        }

    while(true) {
        if(!file){
            cout << "Please enter a command: ";
        }

        if(!getline(in, line)){
            break;
        }
        

        input.clear();       // clear error flags
        input.str(line);

        input >> command;

        if(command == "move"){
            input >> name;
            input >> dir;

            if(move(name, dir)){

                used_ability = false;
                
            }

        }
        else if(command == "ability"){ 
            if(used_ability){
                cout << "Already used an ability this turn" << endl;
            } 
            else if(use_ability(input)){
               used_ability = true;
            };
        }
        //board, quit, sequence 
        //abilities, print abilities 
        else if(command == "abilities"){
            players[turn - 1]->print_abilities();
        }
        else if(command == "board"){
            printgame();
        }                                 
        else if(command == "quit"){
            cout << endl;
            cout << endl;
            printgame();
            cout << "game quitted" << endl;
            ongoing = false;
            break;
        }
        else if(command == "sequence"){
            string filename;
            input >> filename;
            ifstream file{filename};

            if(!file){
                cout << "File could not be opened" << endl;
                continue;
            }
            else{
                play_game(file, true);
                if (!ongoing) {
                    break;
                }
            }
        }
        else{
            cout << "Unknown command: "<< command << endl;
        }

        if(winner() == "player 1" && ongoing){
            ongoing = false;
            cout << endl;
            cout << endl;
            printgame();
            cout << "Player 1 wins!!!" << endl;
            break;
        } 
        else if(winner() == "player 2"&& ongoing){
            ongoing = false;
            cout << endl;
            cout << endl;
            printgame();
            cout << "Player 2 wins!!!" << endl;
            break;
        }
    }
}

Game::~Game() {
    for(int i = 0; i < players.size(); ++i){
        delete players[i];
    }

    for(int j = (min_board - 1); j < board.size(); ++j){
        for (int k = (min_board - 1); k < (board[j]).size(); ++k) {
            delete (board[j])[k];
        }
    }
}

void Game::setGraphics(Display *d1, Display *d2){
    display1 = d1;
    display2 = d2;
}

void Game::notifyGraphics(){
    //cerr <<"DEBUG notifyGRaphics entered display =" << display << endl;
    if(display1 && display2){
        display1->drawBoard(*this);
        display2->drawBoard(*this);
    }
}

void Game::notifyGraphics(int row, int col){
  if(display1 && display2){
        display1->drawTile(*this, row, col);
        display2->drawTile(*this, row, col);
    }
}
void Display::drawBoard(const Game& g){
    for(int row = 0; row < 8; ++row){
        for(int col = 0; col < 8; ++col){
            //coord with size accounted for --> where it actually is (1,2) would actually be at (50,100)
            int boardRow;
            int boardCol;
            int screenRow;
            int screenCol;
            if(perspective == 1){
                boardRow = row;
                boardCol = col;
                screenRow = row;
                screenCol = col;
            }
            else{
                //rotated perspective for p2
                boardRow = row;
                boardCol = col;
                screenRow = 7 - row; //magic numbers here, deal with it later
                screenCol = 7 - col;
            }
            int y = screenRow * cellSize;
            int x = screenCol * cellSize;
            Tile *tile = g.board[boardRow][boardCol]; 
            w.fillRectangle(x,y,cellSize,cellSize,Xwindow::White);
            char character = tile->get_default_char();
            if(tile->get_is_server()){
                character = 'S';
            }
            //check if occupied
            //p1 tile = red, p2 tile = blue, unoccupied = white
            auto occupied = tile->get_who();
            if(character == 'S'){
                w.fillRectangle(x,y,cellSize,cellSize,Xwindow::Green);
            }
            else if(occupied){
                character = occupied->get_name()[0];
                int owner = occupied->get_owner();
                if(owner == 1){
                    w.fillRectangle(x, y, cellSize, cellSize, Xwindow::Red);
                }                                                                       
                else{
                    w.fillRectangle(x, y, cellSize, cellSize, Xwindow::Blue);
                }
            }
            //w.fillRectangle(x, y, cellSize, cellSize, Xwindow::White);
            string str(1,character); 
            int str_x = x + cellSize/3;
            int str_y = y + cellSize/3;
            //make thicker text
            w.drawString(str_x, str_y, str);
            w.drawString(str_x + 1, str_y, str);
            w.drawString(str_x, str_y + 1, str);
        }
    }
}

void Display::drawTile(const Game& g, int row, int col){
    int screenRow;
    int screenCol;
    if(perspective == 1){
        screenRow = row;
        screenCol = col;
    }
    else{
        screenRow = 7 - row;
        screenCol = 7 - col;
    }
    int y = screenRow * cellSize;
    int x = screenCol * cellSize;
    Tile *tile = g.board[row][col];
    int colour = Xwindow::White;
    char character = tile->get_default_char();
   if(tile->get_is_server()){
        colour = Xwindow::Green;
        character = 'S';
    }
    auto occupied = tile->get_who();
    if(occupied){
        character = occupied->get_name()[0];
        int owner = occupied->get_owner();
        if (owner == 1) {
            colour = Xwindow::Red;
        } else {
            colour = Xwindow::Blue;
        }
    }
    w.fillRectangle(x, y, cellSize, cellSize, colour);
    string str(1, character);
     int str_x = x + cellSize/3;
     int str_y = y + cellSize/3;
            //make thicker text
     w.drawString(str_x, str_y, str);
     w.drawString(str_x + 1, str_y, str);
     w.drawString(str_x, str_y + 1, str);
}

