    if(turn == 1){
        turn = 2;
    } 
    else{
        turn = 1;
    }
}
// battle returns loser
Link* Game::battle(Link* link1, Link* link2){
    if(link1->get_strength() >= link2->get_strength()){
        return link2;
    }
    else{
        return link1;
    }
}

//for now assume m is player 1 firewall and w is player 2 firewall
void Game::check_firewall(Tile* tile, Link* link){

    int owner = link->get_owner();
    int other_player;

    if(turn == 1){
        other_player = 2;
    } 
    else{
        other_player = 1;
    }

    if((owner == 1 && tile->get_default_char() == 'w') ||
            (owner == 2 && tile->get_default_char() == 'm')){

        cout << link->get_name() << " stepped on a firewall!" << endl;
        cout << "It was of type " << link->get_type() << link->get_strength() << endl;
        
        if(link->get_type() == "V") {
            cout << "automatically downloading..." << endl;
            player_downloading(players[owner - 1], link);
        } 
        else{

            int index = players[owner - 1]->find_index(link);
            
            players[other_player - 1]->set_known_links(link, index);

        }
    }
}

bool Game::move(string name, string dir){
    Link* link = players[turn - 1]->find_link(name);

    if(link == nullptr){
        cout << "Invalid link" << endl;
        return false;
    }


    int num_steps = 1;

    if(link->get_linkboost() > 0){
        num_steps += link->get_linkboost();
    }
    
    if(!link->get_alive()){
        cout << "Link is already downloaded" << endl;
        return false;
    }

    int old_row = link->get_row();
    int old_col = link->get_col();

    int row = old_row;
    int col = old_col;

    if(dir == "up"){
        if (turn == 1) {
            row -= num_steps;
        } else {
            row += num_steps;
        }
    } 
    else if(dir == "down"){
        if(turn == 1){
            row += num_steps;
        } 
        else{
            row -= num_steps;
        }
    } 
    else if(dir == "left"){
        if(turn == 1){
            col  -= num_steps;
        } 
        else{
            col  += num_steps;
        }
    } 
    else if(dir == "right"){
        if(turn == 1){
            col += num_steps;
        }
        else{
            col -= num_steps;
        }
    } 
    else{
        cout << "Invalid direction" << endl;
        return false;
    }

    if(col >= max_board || col < (min_board - 1)){
        cout << "Out of bounds" << endl;
        return false;
    }

    if(turn == 1){
        if(row < (min_board - 1)){
            cout << "Out of bounds" << endl;
            return false;
        } 
        else if(row >= max_board){
            player_downloading(players[turn - 1], link);
            switch_turn();
            return true;
        }
    } 
    else if(turn == 2){
        if(row >= max_board){
            cout << "Out of bounds" << endl;
            return false;
        } 
        else if(row < (min_board - 1)) {
            player_downloading(players[turn - 1], link);
            switch_turn();
            return true;
        }
    }
//assumed that you can't step on your own server ports
    if(turn == 1 && row == (min_board - 1) && (col == other_server_spot || col == server_spot)){
        cout << "Server port in the way" << endl;
        return false; 
    } 
    else if(turn == 2 && row == (max_board - 1) && (col == other_server_spot || col == server_spot)){
        cout << "Server port in the way" << endl;
        return false;
    } 
    else if(turn == 1 && row == (max_board - 1) && (col == other_server_spot || col == server_spot)){
        player_downloading(players[1], link);
        switch_turn();
        return true;
    } 
    else if(turn == 2 && row == (min_board - 1) && (col == other_server_spot || col == server_spot)){
        player_downloading(players[0], link);
        switch_turn();
        return true;
    }

    Tile* tile = board[row][col];

    if(tile->get_who() != nullptr){
        if((tile->get_who())->get_owner() == turn){
            cout << "Link blocked" << endl;
            return false;
        } 
        else{
            Link* loser = battle(link, tile->get_who());

            if(loser->get_owner() == 1){
                player_downloading(players[1], loser);
            } 
            else{
                player_downloading(players[0], loser);
            }

            if(loser->get_owner() != turn){

                board[old_row][old_col]->clear();

                (*link).set_row(row);
                (*link).set_col(col);

                tile->set_who(link);

                check_firewall(tile, link);

            }
            notifyGraphics(old_row,old_col);

            switch_turn();

            return true;
        }
    }

    board[old_row][old_col]->clear();

    (*link).set_row(row);
    (*link).set_col(col);

    tile->set_who(link);

    check_firewall(tile, link);
    notifyGraphics(old_row,old_col);
    notifyGraphics(row,col);
    switch_turn();

    return true;
    
}

bool Game::scan(string name) {
    int index;

    int other_player = 1;

    if(turn != 2){
        other_player = 2;
    }
 
    for(int i = (min_board - 1); i < max_board; ++i){
        for(int j = (min_board - 1); j < max_board; ++j){
            if (((board[i])[j])->get_who() != nullptr){
                if((((board[i])[j])->get_who())->get_name() == name){
                    if((((board[i])[j])->get_who())->get_owner() == turn){
                        cout << "invalid" << endl;
                        return false;
                    }
                    else{
                        cout << "Revealing " << name << ": ";
                        cout << ((((board[i])[j])->get_who())->get_strength()); 
                        cout << ((((board[i])[j])->get_who())->get_type()) << endl;
                        index = (players[other_player-1])->find_index((((board[i])[j])->get_who()));
                        (players[turn-1])->set_known_links((((board[i])[j])->get_who()), index);
                        return true;
                    }
                }
            }
        }
    }
    cout << "Invalid" << endl;
    return false;
}

bool Game::Revive(Player* owner, Link* link){
    int col = owner->find_index(link);
    int row;

    if(owner->get_player_num() == 1){
        row = 0;
        if(col == 3 || col == 4){
            row = 1;
        }
    }

    if(owner->get_player_num() == 2){
        row = 7;
        if(col == 3 || col == 4){
            row = 6;
        }
    }

    if(board[row][col]->get_who()){
        cout << "Can't revive, orignal tile is not empty" << endl;
        return false;
    }

    link->reset_linkboost();
    link->change_status();
    link->use_teleport(col, row);
    board[row][col]->set_who(link);
    notifyGraphics(row,col);

    return true;

}


bool Game::use_ability(istringstream& command){

    int n;

    if(!(command >> n)){
        if(command.eof()){
            cout << "Wrong number of arguments" << endl;
        } 
        else{
            cout << "Wrong arguments" << endl;
        }

        command.clear();
        return false;
        
    }

    if(n < 1 || n > 5){
        cout << "Invalid ability" << endl;
        return false;
    }

    Ability* a = (players[turn - 1])->get_ability(n);

    if(a->used){
        cout << "Ability already used" << endl;
        return false;
    }

    string link_name;
    int other_player;
    int row;
    int col;
    Link* link;
    Tile* tile;

    if(turn == 1){
        other_player = 2;
    } 
    else{
        other_player = 1;
    }

    if(a->name == "Link Boost"){

        if(!(command >> link_name)){
            if(command.eof()){
                cout << "Wrong number of arguments" << endl;
            } 
            else{
                cout << "Wrong arguments" << endl;
            }

            command.clear();
            return false;
        }

        link = players[turn - 1]->find_link(link_name);

        if(!link){
            cout << "Link does not exist" << endl;
            return false;
        }

        if(!link->get_alive()){
            cout << "Link has already been downloaded" << endl;
            return false;
        }

        link->use_linkboost();
        a->used = true;
        players[turn - 1]->decrease_abilities_left();

        return true;


    } 
    else if(a->name == "Firewall"){

        if(!(command >> col)){
            if(command.eof()){
                cout << "Wrong number of arguments" << endl;
            } 
            else{
                cout << "Wrong arguments" << endl;
            }

            command.clear();
            return false;
        }
        if(!(command >> row)){
