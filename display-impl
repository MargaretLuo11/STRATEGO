Game::Game(string ability1, string ability2, string links1, string links2) {
    turn = 1;
    ongoing = true;

    players.push_back(new Player(1, ability1, links1));
    players.push_back(new Player(2, ability2, links2));

    board.resize(max_board);

    for(int i = (min_board - 1); i < max_board; i++){
        if(i == server_spot || i == other_server_spot){
            board[0].push_back(new Tile(nullptr, 'S', true));
        } 
        else{
            board[0].push_back(new Tile((*players[0]->get_links())[i], '.', false));
        }
    }

    for(int i = (min_board - 1); i < max_board; i++){
        if(i == server_spot || i == other_server_spot){
            board[1].push_back(new Tile((*players[0]->get_links())[i], '.', false));
        } 
        else{
            board[1].push_back(new Tile(nullptr, '.', false));
        }
    }
    for(int j = bot_mid; j < top_mid; j++){
        for(int i = (min_board - 1); i < max_board; i++){
            board[j].push_back(new Tile(nullptr, '.', false));
        }
    }

    for(int i = (min_board - 1); i < max_board; i++){
        if(i == server_spot || i == other_server_spot){
            board[6].push_back(new Tile((*players[1]->get_links())[i], '.', false));
        } 
        else{
            board[6].push_back(new Tile(nullptr, '.', false));
        }
    }

    for(int i = (min_board - 1); i < max_board; i++){
        if(i == server_spot || i == other_server_spot){
            board[7].push_back(new Tile(nullptr, 'S', true));
        } 
        else{
            board[7].push_back(new Tile((*players[1]->get_links())[i], '.', false));
        }
    }
}

void Game::Jumble(){
    auto player1_links = players[0]->get_links();
    auto player2_links = players[1]->get_links();
    for(Link* l: *player1_links){
        while(true){
            int new_col = getRandom();
            int new_row = getRandom();
        //check if this is an empty spot 
            Tile* potential_move = board[new_row][new_col];
        //if the tile is empty, move it there, else redo the process
            if(!(potential_move->get_who()) && potential_move->get_default_char() == '.' && !potential_move->get_is_server()){
                //clear current tile, update new tile, update link coord
                board[l->get_row()][l->get_col()]->clear();
                potential_move->set_who(l);
                l->set_row(new_row);
                l->set_col(new_col);
                break;
            }
        }       
    }
    for(Link* m: *player2_links){
        while(true){
            int new_col2 = getRandom();
            int new_row2 = getRandom();
            Tile* potential_move2 = board[new_row2][new_col2];
            if(!(potential_move2->get_who()) && potential_move2->get_default_char() == '.' && !potential_move2->get_is_server()){
                board[m->get_row()][m->get_col()]->clear();
                potential_move2->set_who(m);
                m->set_row(new_row2);
                m->set_col(new_col2);
                break;
            }
        }      
    }
    notifyGraphics();
}

int Game::getRandom(){
    random_device rd;
    mt19937 gen(rd());
    uniform_int_distribution<int> dist((min_board - 1), (max_board - 1));
    int x = dist(gen);
    return x;
}

bool Game::Teleport(string link_name, int col, int row){
    //check if it is out of bounds 
    if(col < (min_board - 1) || col > (max_board - 1)){
        cout << "position given is out of bounds" << endl;
        return false;
    }
    if(row < (min_board - 1) || row > (max_board - 1)){
        cout << "position given is out of bounds" << endl;
        return false;
    }
//need to check if it is empty
    Link* this_link = players[turn - 1]->find_link(link_name);
    Tile* suggested_move = board[row][col];
    if(suggested_move->get_default_char() == '.' &&!suggested_move->get_who()){
        int old_row = this_link->get_row();
        int old_col = this_link->get_col();
        board[this_link->get_row()][this_link->get_col()]->clear();
        suggested_move->set_who(this_link);
        this_link->use_teleport(col, row);
        cout << "whoosh whoosh~~successful teleport" << endl;
        notifyGraphics(old_row,old_col);
        notifyGraphics(row,col);
        return true;
    }
    cout << "you can't move there nuh uh " << endl;
    return false;
}



